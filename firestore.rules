rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read/write for CRM operations
    match /users/{userId} {
      allow read, write: if true;
    }
    
    match /employees/{employeeId} {
      allow read, write: if true;
    }
    
    match /auditLogs/{logId} {
      allow read, write: if true;
    }

    match /tenants/{tenantId}/{document=**} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
