# Firebase Configuration for ePay CRM
# Copy this file to .env and fill in your actual credentials

# Environment name
NODE_ENV=production

# ============================================
# Firebase Core Configuration
# ============================================
FIREBASE_API_KEY=your_api_key_here
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_MEASUREMENT_ID=G-your_analytics_id

# Next.js Client-side aliases
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ============================================
# Firebase Realtime Database
# ============================================
FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.asia-southeast1.firebasedatabase.app
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.asia-southeast1.firebasedatabase.app

# ============================================
# Email Configuration (SendGrid) - Server Side Secrets
# ============================================
SENDGRID_API_KEY=SG.your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@epaycrm.com

# ============================================
# SMS/VoIP Configuration (Twilio) - Server Side Secrets
# ============================================
TWILIO_ACCOUNT_SID=ACyour_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890

# ============================================
# Session Timer Configuration (Client Side)
# ============================================
NEXT_PUBLIC_INACTIVITY_THRESHOLD_MS=900000
NEXT_PUBLIC_BREAK_START_HOUR=13
NEXT_PUBLIC_BREAK_END_HOUR=14
NEXT_PUBLIC_SHIFT_END_HOUR=18

# ============================================
# Feature Toggles (Client Side)
# ============================================
NEXT_PUBLIC_EMAIL_ENABLED=true
NEXT_PUBLIC_CALLING_ENABLED=true
NEXT_PUBLIC_SESSION_TIMER_ENABLED=true