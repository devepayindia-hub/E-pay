# Firebase Configuration for ePay CRM
# Copy this file to .env and fill in your actual credentials

# Environment name
NODE_ENV=development

# ============================================
# Firebase Core Configuration
# ============================================
# Get these from Firebase Console → Project Settings → General → Your apps
FIREBASE_API_KEY=your_api_key_here
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_MEASUREMENT_ID=G-your_analytics_id

# ============================================
# Firebase Realtime Database
# ============================================
FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.asia-southeast1.firebasedatabase.app

# ============================================
# Email Configuration (SendGrid)
# ============================================
VITE_SENDGRID_API_KEY=SG.your_sendgrid_api_key
VITE_SENDGRID_FROM_EMAIL=noreply@epaycrm.com

# ============================================
# SMS/VoIP Configuration (Twilio)
# ============================================
VITE_TWILIO_ACCOUNT_SID=ACyour_twilio_account_sid
VITE_TWILIO_AUTH_TOKEN=your_twilio_auth_token
VITE_TWILIO_FROM_NUMBER=+1234567890

# ============================================
# Session Timer Configuration
# ============================================
VITE_INACTIVITY_THRESHOLD_MS=900000
VITE_BREAK_START_HOUR=13
VITE_BREAK_END_HOUR=14
VITE_SHIFT_END_HOUR=18

# ============================================
# Feature Toggles
# ============================================
VITE_EMAIL_ENABLED=true
VITE_CALLING_ENABLED=true
VITE_SESSION_TIMER_ENABLED=true